# Night Shift orchestrator env
# Copy this file to .env and fill in real values. Do NOT commit .env.

# Roblox Open Cloud API key
# Create at https://create.roblox.com/dashboard/credentials
# Scopes: universe-datastores.objects:read/update/create + universe.messaging-service:publish
ROBLOX_API_KEY=

# Universe ID (NOT placeId) — find at https://create.roblox.com/dashboard/creations
UNIVERSE_ID=

# Night number (YYYYMMDD) — orchestrator idempotent-checks against this
NIGHT=

# LLM (Groq — free, no credit card)
LLM_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
