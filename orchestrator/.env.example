# Night Shift orchestrator env
# Copy this file to .env and fill in real values. Do NOT commit .env.

# Roblox Open Cloud API key
# Create at https://create.roblox.com/dashboard/credentials
# Use the FULL key string (~964 chars, baseApiKey + JWT concatenated) — NOT just the 48-char prefix.
# Scopes needed: universe-datastores.control:create + objects:read/update/create + universe.messaging-service:publish
# (control:create is REQUIRED for PATCH allowMissing=true, else 403)
ROBLOX_API_KEY=

# Universe ID (NOT placeId) — find at https://create.roblox.com/dashboard/creations
UNIVERSE_ID=

# Night number (YYYYMMDD) — orchestrator idempotent-checks against this
NIGHT=

# LLM (Groq — free, no credit card)
LLM_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
